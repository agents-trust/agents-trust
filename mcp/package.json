{
  "name": "@agents-trust/mcp",
  "version": "0.1.0",
  "description": "Find APIs, inspect endpoint evidence and look up payment receipts with Agents Trust.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --exclude test/paid.test.ts",
    "prepack": "npm run build",
    "test:paid": "vitest run test/paid.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "bundle": "npm run build && node scripts/bundle.mjs",
    "check:artifacts": "node scripts/check-artifacts.mjs"
  },
  "keywords": [],
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "@x402/fetch": "2.28.0",
    "viem": "2.57.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.12",
    "fflate": "0.8.3"
  },
  "bin": {
    "agents-trust-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/agents-trust/agents-trust.git",
    "directory": "mcp"
  },
  "homepage": "https://agents-trust.com",
  "mcpName": "com.agents-trust/recommend"
}
